 create mode 100644 target/linux/ramips/dts/mt7621_melonpi-m21.dtsi

diff --git a/target/linux/ramips/dts/mt7621_melonpi-m21-16m.dts b/target/linux/ramips/dts/mt7621_melonpi-m21-16m.dts
new file mode 100644
