diff --git a/target/linux/ramips/dts/mt7621_melonpi-m21-32m.dts b/target/linux/ramips/dts/mt7621_melonpi-m21-32m.dts
new file mode 100644
index 0000000000..9bcd2b54ac
--- /dev/null
+++ b/target/linux/ramips/dts/mt7621_melonpi-m21-32m.dts
@@ -0,0 +1,11 @@
+#include "mt7621_melonpi-m21.dtsi"
+
+/ {
+	compatible = "melonpi,m21-32m", "melonpi,m21", "mediatek,mt7621-soc";
+	model = "MelonPi M21 (32M flash)";
